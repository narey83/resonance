+        [Trait("Category", "UploadFromFileAsync")]
+        [Theory(DisplayName = "UploadFromFileAsync disconnects at MaximumLingerTime when the receiver goes silent"), AutoData]
+        public async Task UploadFromFileAsync_Disconnects_At_MaximumLingerTime_When_The_Receiver_Goes_Silent(string username, IPEndPoint endpoint, string filename, byte[] data, int token, int size)
+        {
+            using (var testFile = new TestFile(data))
+            {
+                var options = new SoulseekClientOptions(messageTimeout: 5);
+
+                var response = new TransferResponse(token, size);
+                var responseWaitKey = new WaitKey(MessageCode.Peer.TransferResponse, username, token);
+
+                var waiter = new Mock<IWaiter>();
+                waiter.Setup(m => m.Wait<TransferResponse>(It.Is<WaitKey>(w => w.Equals(responseWaitKey)), It.IsAny<int?>(), It.IsAny<CancellationToken>()))
+                    .Returns(Task.FromResult(response));
+                waiter.Setup(m => m.Wait<UserAddressResponse>(It.IsAny<WaitKey>(), It.IsAny<int?>(), It.IsAny<CancellationToken>()))
+                    .Returns(Task.FromResult(new UserAddressResponse(username, endpoint.Address, endpoint.Port)));
+
+                var conn = new Mock<IMessageConnection>();
+                conn.Setup(m => m.State)
+                    .Returns(ConnectionState.Connected);
+
+                var transferConn = new Mock<IConnection>();
+                transferConn.Setup(m => m.ReadAsync(It.Is<long>(l => l == 8), It.IsAny<CancellationToken?>()))
+                    .Returns(Task.FromResult(BitConverter.GetBytes(0L)));
+
+                // the receiver never sends anything and never hangs up, so this read never returns. a peer
+                // re-requesting a file it already holds in full behaves exactly like this: the start offset equals
+                // the size, so neither side has anything left to send. the linger deadline has to be enforceable
+                // against it, otherwise the connection is held until the inactivity timeout fires instead.
+                transferConn.Setup(m => m.ReadAsync(It.Is<long>(l => l == 1), It.IsAny<CancellationToken?>()))
+                    .Returns(new TaskCompletionSource<byte[]>().Task);
+
+                var connManager = new Mock<IPeerConnectionManager>();
+                connManager.Setup(m => m.GetOrAddMessageConnectionAsync(username, endpoint, It.IsAny<CancellationToken>()))
+                    .Returns(Task.FromResult(conn.Object));
+                connManager.Setup(m => m.GetTransferConnectionAsync(username, endpoint, token, It.IsAny<CancellationToken>()))
+                    .Returns(Task.FromResult(transferConn.Object));
+
+                var diagnostic = new Mock<IDiagnosticFactory>();
+
+                var txOptions = new TransferOptions(maximumLingerTime: 200);
+
+                using (var s = new SoulseekClient(minorVersion: 9999, options: options, diagnosticFactory: diagnostic.Object, waiter: waiter.Object, serverConnection: conn.Object, peerConnectionManager: connManager.Object))
+                {
+                    s.SetProperty("State", SoulseekClientStates.Connected | SoulseekClientStates.LoggedIn);
+
+                    var upload = Record.ExceptionAsync(() => s.InvokeMethod<Task>("UploadFromFileAsync", username, filename, testFile.Path, token, txOptions, null));
+
+                    Assert.Same(upload, await Task.WhenAny(upload, Task.Delay(10000)));
+                    Assert.Null(await upload);
+                }
+
+                transferConn.Verify(m => m.Disconnect(It.Is<string>(s => s.ContainsInsensitive("maximum linger time")), null), Times.Once);
+                diagnostic.Verify(m => m.Warning(It.Is<string>(s => s.ContainsInsensitive("maximum linger time")), null), Times.Once);
+            }
+        }
+
