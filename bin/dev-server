#!/usr/bin/env python3
"""Manage the live-reloading Resonance services on the Linux development server."""
import argparse
import subprocess
import sys

COMPOSE = ['docker', 'compose', '-p', 'resonance', '-f', '/mnt/data/containers/resonance/docker-compose.yml', '-f', '/mnt/data/containers/resonance/mac-development.yml']


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['start', 'stop', 'restart', 'status', 'logs', 'build'])
    parser.add_argument('services', nargs='*', choices=['backend', 'web'])
    args = parser.parse_args()
    services = ['frontend' if s == 'web' else s for s in args.services] or ['backend', 'frontend']
    if args.action == 'restart':
        subprocess.run(COMPOSE + ['stop'] + services, check=True)
    verb = {'start': ['up', '-d', '--wait'], 'restart': ['up', '-d', '--wait'], 'status': ['ps'], 'logs': ['logs', '--tail', '80', '-f']}.get(args.action, [args.action])
    return subprocess.run(COMPOSE + verb + services).returncode


if __name__ == '__main__':
    try: sys.exit(main())
    except subprocess.CalledProcessError as error: sys.exit(error.returncode)
