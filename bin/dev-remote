#!/usr/bin/env python3
"""Manage server development and the Mac's private SSH port forwards."""
import argparse
import os
import signal
import time
from pathlib import Path
import shlex
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
STATE = ROOT / '.dev' / 'remote'
SOCKET = STATE / 'ssh.sock'
MOBILE_PID = STATE / 'mobile-sync.pid'
MOBILE_EXCLUDES = ['node_modules', '/ios/', '/android/', '/.expo/', '/dist/', '/web-build/', '/.kotlin/', '.env*', '*.jks', '*.p8', '*.p12', '*.key', '*.pem', '*.mobileprovision', '/google-services.json', 'expo-env.d.ts', '*.tsbuildinfo', '*.log', '.DS_Store']
HOST = 'resonance-dev'
COMPOSE = ['docker', 'compose', '-p', 'resonance', '-f', '/mnt/data/containers/resonance/docker-compose.yml', '-f', '/mnt/data/containers/resonance/mac-development.yml']
SSH = ['ssh', '-o', 'BatchMode=yes', '-o', 'StrictHostKeyChecking=yes', '-o', 'ConnectTimeout=10']


def connected():
    return SOCKET.exists() and subprocess.run(SSH + ['-S', str(SOCKET), '-O', 'check', HOST], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def connect():
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    if not connected():
        if SOCKET.exists(): SOCKET.unlink()
        subprocess.run(SSH + ['-M', '-S', str(SOCKET), '-fNT', '-o', 'ExitOnForwardFailure=yes', '-L', '127.0.0.1:3000:127.0.0.1:3000', '-L', '127.0.0.1:55450:127.0.0.1:55450', HOST], check=True)
    print('Server web: http://localhost:3000  API: http://127.0.0.1:55450')


def sync_mobile():
    transport = SSH + (['-S', str(SOCKET)] if connected() else [])
    command = ['rsync', '-az', '--delete', '--safe-links', '-e', shlex.join(transport)]
    command += ['--exclude=' + pattern for pattern in MOBILE_EXCLUDES]
    command += [HOST + ':/mnt/data/projects/resonance/mobile/', str(ROOT / 'mobile') + '/']
    subprocess.run(command, check=True)


def mobile_pid():
    try:
        pid = int(MOBILE_PID.read_text())
        result = subprocess.run(['ps', '-p', str(pid), '-o', 'command='], capture_output=True, text=True)
        return pid if result.returncode == 0 and str(Path(__file__).resolve()) + ' _watch-mobile' in result.stdout else None
    except (ValueError, OSError): return None


def stop_mobile_sync():
    pid = mobile_pid()
    if pid: os.killpg(pid, signal.SIGTERM)
    MOBILE_PID.unlink(missing_ok=True)


def watch_mobile():
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    if mobile_pid(): return
    sync_mobile()
    with (STATE / 'mobile-sync.log').open('ab') as log:
        process = subprocess.Popen([sys.executable, str(Path(__file__).resolve()), '_watch-mobile'], stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
    MOBILE_PID.write_text(str(process.pid))
    print('Mobile source mirror: server → Mac; native projects and local credentials retained.')


def main():
    if len(sys.argv) == 2 and sys.argv[1] == '_watch-mobile':
        while True:
            try: sync_mobile()
            except subprocess.CalledProcessError as error: print('Mobile mirror retry:', error.returncode, flush=True)
            time.sleep(3)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['connect', 'disconnect', 'start', 'stop', 'restart', 'status', 'logs', 'build', 'sync-mobile', 'watch-mobile', 'stop-mobile-sync'])
    parser.add_argument('services', nargs='*', choices=['backend', 'web'])
    args = parser.parse_args()
    if args.action in ('sync-mobile', 'watch-mobile', 'stop-mobile-sync'):
        {'sync-mobile': sync_mobile, 'watch-mobile': watch_mobile, 'stop-mobile-sync': stop_mobile_sync}[args.action]()
        return 0
    if args.action == 'connect':
        connect()
        return 0
    if args.action == 'disconnect':
        stop_mobile_sync()
        if connected(): subprocess.run(SSH + ['-S', str(SOCKET), '-O', 'exit', HOST], check=True)
        return 0
    services = ['frontend' if name == 'web' else name for name in args.services] or ['backend', 'frontend']
    if args.action == 'status':
        print('Mobile source mirror: ' + ('running' if mobile_pid() else 'stopped'))
        print('SSH forwards: ' + ('connected' if connected() else 'disconnected'))
        command = COMPOSE + ['ps'] + services
    elif args.action == 'logs': command = COMPOSE + ['logs', '--tail', '80', '-f'] + services
    elif args.action == 'build': command = COMPOSE + ['build'] + services
    elif args.action == 'stop': command = COMPOSE + ['stop'] + services
    elif args.action == 'restart': command = COMPOSE + ['restart'] + services
    else: command = COMPOSE + ['up', '-d', '--wait'] + services
    result = subprocess.run(SSH + [HOST, shlex.join(command)]).returncode
    if result == 0 and args.action in ('start', 'restart'): connect()
    return result


if __name__ == '__main__':
    try: sys.exit(main())
    except subprocess.CalledProcessError as error: sys.exit(error.returncode)
