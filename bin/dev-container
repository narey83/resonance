#!/usr/bin/env python3
"""Manage the portable Docker development stack without deleting its data."""
import argparse
import json
import os
from pathlib import Path
import shutil
import sqlite3
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parent.parent
RUNTIME = ROOT / '.dev' / 'docker'
CONFIG = RUNTIME / 'config.json'


def configuration():
    return json.loads(CONFIG.read_text()) if CONFIG.exists() else {
        'context': 'colima-resonance-dev' if sys.platform == 'darwin' else '',
        'webPort': 3001, 'apiPort': 55451, 'peerPort': 50302, 'peerBind': '127.0.0.1', 'noConnect': True,
    }


def environment(config):
    return {**os.environ,
            'LOCAL_UID': str(getattr(os, 'getuid', lambda: 1000)()),
            'LOCAL_GID': str(getattr(os, 'getgid', lambda: 1000)()),
            'DOCKER_CONTEXT': config.get('context', ''),
            'DOCKER_CLI_PLUGIN_EXTRA_DIRS': '/opt/homebrew/lib/docker/cli-plugins',
            'RESONANCE_DOCKER_WEB_PORT': str(config['webPort']),
            'RESONANCE_DOCKER_API_PORT': str(config['apiPort']),
            'RESONANCE_DOCKER_PEER_PORT': str(config['peerPort']),
            'RESONANCE_DOCKER_PEER_BIND': config.get('peerBind', '127.0.0.1'),
            'RESONANCE_DOCKER_NO_CONNECT': str(config['noConnect']).lower(),
            'RESONANCE_DOCKER_APP_DIR': str(RUNTIME / 'app')}


def compose(args, config, check=True):
    # Homebrew provides a standalone Compose executable as well as the CLI plugin.
    standalone = shutil.which('docker-compose')
    executable = [standalone] if standalone else ['docker', 'compose']
    return subprocess.run(executable + ['-f', str(ROOT / 'docker' / 'compose.local.yml')] + args,
                          cwd=ROOT, env=environment(config), check=check).returncode


def import_native(config):
    executable = [shutil.which('docker-compose')] if shutil.which('docker-compose') else ['docker', 'compose']
    result = subprocess.run(executable + ['-f', str(ROOT / 'docker' / 'compose.local.yml'), 'ps', '-q', 'backend'],
                            env=environment(config), capture_output=True, text=True, check=True)
    if result.stdout.strip():
        raise RuntimeError('Stop the Docker stack before importing the native dev data.')
    source = ROOT / '.dev' / 'app'
    target = RUNTIME / 'app'
    if not (source / 'data' / 'resonance.db').exists():
        raise RuntimeError('No native SQLite dev database found under .dev/app.')
    if target.exists():
        target.rename(RUNTIME / ('app-before-import-' + time.strftime('%Y%m%d-%H%M%S')))
    shutil.copytree(source, target, ignore=shutil.ignore_patterns('*.db', '*-wal', '*-shm', 'bin', 'logs'))
    for original in source.rglob('*.db'):
        destination = target / original.relative_to(source)
        destination.parent.mkdir(parents=True, exist_ok=True)
        with sqlite3.connect(f'file:{original}?mode=ro', uri=True) as incoming, sqlite3.connect(destination) as outgoing:
            incoming.backup(outgoing)
    print('Copied a consistent SQLite snapshot; native dev data was left intact.')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['start', 'stop', 'restart', 'status', 'logs', 'build', 'import-native'])
    parser.add_argument('services', nargs='*', choices=['backend', 'web'])
    args = parser.parse_args()
    RUNTIME.mkdir(parents=True, exist_ok=True)
    config = configuration()
    if not CONFIG.exists():
        CONFIG.write_text(json.dumps(config, indent=2) + '\n')
    if not shutil.which('docker'):
        raise RuntimeError('Install Docker (Docker Desktop, Colima, or a Linux Docker engine) first.')
    if args.action in ('start', 'build', 'restart', 'import-native'):
        probe = subprocess.run(['docker', 'info'], env=environment(config), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if probe.returncode:
            context = config.get('context', '')
            if context.startswith('colima-') and shutil.which('colima'):
                subprocess.run(['colima', 'start', context.removeprefix('colima-'), '--activate=false'], check=True)
            else:
                raise RuntimeError('Start the Docker engine, then run this command again.')
    if args.action == 'import-native':
        import_native(config)
        return 0
    if args.action == 'start':
        (RUNTIME / 'app').mkdir(parents=True, exist_ok=True)
        code = compose(['up', '-d', '--wait'] + args.services, config)
        print(f"Web: http://localhost:{config['webPort']}  API: http://127.0.0.1:{config['apiPort']}")
        return code
    if args.action == 'stop':
        return compose(['stop'] + args.services, config)
    if args.action == 'restart':
        compose(['stop'] + args.services, config)
        return compose(['up', '-d', '--wait'] + args.services, config)
    if args.action == 'status':
        return compose(['ps'], config)
    if args.action == 'logs':
        return compose(['logs', '--tail', '100', '-f'] + args.services, config)
    return compose(['build'] + args.services, config)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (RuntimeError, subprocess.CalledProcessError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
