{
  "manifest_version": 3,
  "name": "Resonance Cookie Sync",
  "version": "1.0",
  "description": "Automatically sync YouTube cookies to your Resonance server for age-restricted content.",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": ["*://*.youtube.com/*", "http://*/*", "https://*/*"],
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "48": "icons/48.png" } },
  "background": { "scripts": ["browser-polyfill.js", "background.js"] },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "browser_specific_settings": {
    "gecko": { "id": "resonance-cookie-sync@local", "strict_min_version": "109.0" }
  }
}
