# EditorConfig — consistent whitespace/encoding across the C#, JS/TS, and config
# files in this repo. C# code-style is governed by StyleCop (backend/Properties/
# stylecop.json); this file only sets indentation/charset/newlines so editors
# don't fight each other. See https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# Backend C#
[*.cs]
indent_size = 4

# .NET project/config XML
[*.{csproj,props,targets,config,nuspec,xml}]
indent_size = 2

# Frontend & mobile (React / Expo)
[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2

# Data / config formats
[*.{json,jsonc,css,scss,less,html,yml,yaml}]
indent_size = 2

# Markdown — trailing whitespace is significant (two spaces = hard line break)
[*.md]
trim_trailing_whitespace = false

# Shell scripts
[*.sh]
indent_size = 2
