+    @MainThread
+    fun setBrowseTree(data: ReadableMap): String {
+        val newTree = HashMap<String, List<MediaItem>>()
+        val newIndex = HashMap<String, MediaItem>()
+
+        val keys = data.keySetIterator()
+        while (keys.hasNextKey()) {
+            val parentId = keys.nextKey()
+            val arr: ReadableArray = data.getArray(parentId) ?: continue
+            val children = ArrayList<MediaItem>(arr.size())
+            for (i in 0 until arr.size()) {
+                val childMap = arr.getMap(i) ?: continue
+                val item = buildBrowseMediaItem(childMap) ?: continue
+                children.add(item)
+                newIndex[item.mediaId] = item
+            }
+            newTree[parentId] = children
+        }
+
+        browseTree.clear(); browseTree.putAll(newTree)
+        browseIndex.clear(); browseIndex.putAll(newIndex)
+
+        // Tell connected controllers (Android Auto) to re-request the nodes that
+        // changed so freshly-loaded children become visible.
+        if (::mediaSession.isInitialized) {
+            for ((parentId, children) in newTree) {
+                mediaSession.notifyChildrenChanged(parentId, children.size, null)
+            }
+        }
+        return "ok:${newTree.size}"
+    }
