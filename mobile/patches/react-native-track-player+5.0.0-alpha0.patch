+    private fun buildBrowseMediaItem(map: ReadableMap): MediaItem? {
+        val mediaId = if (map.hasKey("mediaId")) map.getString("mediaId") else null
+        if (mediaId.isNullOrEmpty()) return null
+        val isBrowsable = map.hasKey("playable") && map.getString("playable") == "1"
+        val title = if (map.hasKey("title")) map.getString("title") else null
+        val subtitle = if (map.hasKey("subtitle")) map.getString("subtitle") else null
+        val iconUri = if (map.hasKey("iconUri")) map.getString("iconUri") else null
+
+        val metadata = MediaMetadata.Builder()
+            .setTitle(title)
+            .setSubtitle(subtitle)
+            .setIsBrowsable(isBrowsable)
+            .setIsPlayable(!isBrowsable)
+            .setMediaType(
+                if (isBrowsable) MediaMetadata.MEDIA_TYPE_FOLDER_MIXED
+                else MediaMetadata.MEDIA_TYPE_MUSIC
+            )
+            .apply { if (!iconUri.isNullOrEmpty()) setArtworkUri(Uri.parse(iconUri)) }
+            .build()
+
+        val builder = MediaItem.Builder()
+            .setMediaId(mediaId)
+            .setMediaMetadata(metadata)
+        // Carry the stream URL when present so the media3 player can resolve the
+        // item even though JS drives actual playback via `remote-play-id`.
+        if (map.hasKey("mediaUri")) {
+            map.getString("mediaUri")?.let { if (it.isNotEmpty()) builder.setUri(it) }
+        }
+        return builder.build()
+    }
