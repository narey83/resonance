{
  "expo": {
    "name": "Resonance",
    "slug": "resonance-mobile",
    "scheme": "resonance",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.resonance.mobile"
    },
    "android": {
      "package": "com.resonance.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#121F20",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121F20",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#121F20",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "./plugins/withStudio",
      "./plugins/withAndroidAuto",
      "./plugins/withCarPlay",
      "./plugins/withFloatingOverlay",
      "./plugins/withBackgroundChat",
      "./plugins/withAdaptiveWindow",
      "./plugins/withGradleProperties",
      "./plugins/withLocalNetworkAccess",
      "./plugins/withGradleWrapperVersion",
      [
        "react-native-google-cast",
        {
          "receiverAppId": "CC1AD845",
          "androidPlayServicesCastFrameworkVersion": "22.3.1"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#388bfd"
        }
      ],
      "expo-image",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your music library.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save tracks to your music library.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to scan the sign-in code shown in Resonance on your computer.",
          "recordAudioAndroid": false
        }
      ],
      "expo-audio",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID to sign in to your saved Resonance servers."
        }
      ],
      "expo-sqlite",
      "expo-status-bar",
      "expo-font",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true,
            "usePrecompiledModules": false
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "016a5e6a-4436-4774-b54a-fd959a9e7cff"
      }
    }
  }
}
