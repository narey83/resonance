{
  "expo": {
    "name": "Resonance",
    "slug": "resonance-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.resonance.mobile"
    },
    "android": {
      "package": "com.resonance.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "./plugins/withAndroidAuto",
      "./plugins/withFloatingOverlay",
      "./plugins/withGradleProperties",
      "./plugins/withLocalNetworkAccess",
      "./plugins/withGradleWrapperVersion",
      [
        "react-native-google-cast",
        {
          "receiverAppId": "FCD2E029"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#388bfd"
        }
      ],
      "expo-image",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your music library.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save tracks to your music library.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to scan the sign-in code shown in Resonance on your computer.",
          "recordAudioAndroid": false
        }
      ],
      "expo-audio",
      "expo-secure-store",
      "expo-sqlite",
      "expo-status-bar",
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "016a5e6a-4436-4774-b54a-fd959a9e7cff"
      }
    }
  }
}
